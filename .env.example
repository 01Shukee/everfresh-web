# Set to "false" at launch to hide every placeholder and unverified block.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
# Later phases: DATABASE_URL, AUTH_SECRET, BACHS_API_KEY, BACHS_WEBHOOK_SECRET, WHATSAPP_NUMBER_DIGITS
SITE_URL=http://localhost:3000
DATABASE_URL=
# Bachs: sandbox keys start sk_sandbox_; the live key is a swap to sk_live_ with BACHS_BASE_URL=https://api.bachs.io
BACHS_API_KEY=
BACHS_BASE_URL=https://sandbox-api.bachs.io
BACHS_WEBHOOK_SECRET=           # endpoint signing secret; comma-separate two during rotation
# Staff sign-in. ADMIN_EMAIL + ADMIN_PASSWORD (12+ chars) create the first Owner account on first sign-in; remove them afterwards. ADMIN_SESSION_SECRET: 32+ random characters.
ADMIN_EMAIL= admin@everfresh.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Business WhatsApp number for quotation requests: digits with country code, e.g. 234XXXXXXXXXX (no + or spaces). Leave empty until supplied.
WHATSAPP_NUMBER_DIGITS=
# Email (decision: Resend). Verify your sending domain in Resend first.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Everfresh <hello@your-domain>"
# Scheduler secret for GET/POST /api/cron/outbox (24+ random characters)
CRON_SECRET=
TRUSTED_PROXY_HOPS=1
MEDIA_DIR=/data/uploads
REQUIRE_2FA_ROLES="manager"
# Uploads (photos, videos, captions) on Vercel or any host without a persistent disk: create a PUBLIC Vercel Blob store and connect it to the project. That adds BLOB_READ_WRITE_TOKEN automatically. When it is set, uploads go to Blob; when empty, files are saved in MEDIA_DIR.
BLOB_READ_WRITE_TOKEN=